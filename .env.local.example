# Database
DATABASE_URL=postgresql://user:password@localhost:5432/calorie_tracker

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-minimum-32-chars

# Optional: OAuth Providers (for future enhancement)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# USDA API (optional, has free public access with rate limits)
USDA_API_KEY=DEMO_KEY

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=debug
